# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y configura los valores según tu entorno

# Configuración del servidor
PORT=3000

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Base de datos - URL completa de conexión
# Ejemplos:
# PostgreSQL: postgresql://usuario:password@localhost:5432/nombre_db
# MySQL: mysql://usuario:password@localhost:3306/nombre_db
# MongoDB: mongodb://localhost:27017/nombre_db
DATABASE_URL=postgresql://manager_user:manager_password@localhost:5432/manager_system

# Secreto para JWT - DEBE ser mínimo 32 caracteres para seguridad
JWT_SECRET=your-super-secret-jwt-key-here-that-is-at-least-32-characters-long-for-security

# Configuración de CORS - URLs permitidas (separadas por coma)
# Ejemplos:
# CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000,https://miapp.com
CORS_ORIGIN=http://localhost:3000

# Nivel de logging (error | warn | info | debug)
LOG_LEVEL=info